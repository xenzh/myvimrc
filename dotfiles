#!/bin/bash
#
# Usage:
#   ./dotfiles install   - symlink configs, install submodules, mise, OS packages
#   ./dotfiles update    - update mise-managed tools and git submodules


DOTFILES="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"


function fail() {
    echo "$1" >&2
    exit 1
}

function yes_or_no {
    [[ ${-#*i} != ${-} ]] && return 0

    while true; do
        read -rp "$* [y/n]: " yn
        case $yn in
            [Yy]*) return 0  ;;
            [Nn]*) echo "Aborted" ; return  1 ;;
        esac
    done
}

function link() {
    local target="$1" dest="$2"

    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$target" ]; then
        return
    fi
    if [ -e "$dest" ] || [ -L "$dest" ]; then
        echo "!! $dest already exists and isn't the expected symlink, skipping"
        return
    fi
    ln -s "$target" "$dest"
}


function cmd_install() {

echo "-- 1. Downloading and initializing git submodules"

if ! command -v git &> /dev/null; then
    fail "!! git cannot be found"
fi

yes_or_no "?? Download submodules" && git submodule update --init --remote --recursive


echo "-- 2. Installing vim/nvim config"

link "$DOTFILES/vim/.vimrc" ~/.vimrc

mkdir -p ~/.config/nvim
link "$DOTFILES/vim/init.vim" ~/.config/nvim/init.vim


echo "-- 3. Installing tmux config"

touch ~/.tmux.conf
TMUX_SOURCEFILE="source-file $DOTFILES/tmux/.tmux.conf"

if grep -Fxq "$TMUX_SOURCEFILE" ~/.tmux.conf; then
    echo "-- Tmux config is already sourced"
else
    echo -e "$TMUX_SOURCEFILE\n" | cat - ~/.tmux.conf > temp && mv temp ~/.tmux.conf
fi


echo "-- 4. Installing zsh config"

touch ~/.zshrc
ZSH_SOURCE="source $DOTFILES/zsh/.zshrc"

if grep -Fxq "$ZSH_SOURCE" ~/.zshrc; then
    echo "-- Zsh config is already sourced"
else
    echo -e "$ZSH_SOURCE\n" | cat - ~/.zshrc > temp && mv temp ~/.zshrc
fi


echo "-- 5. Installing nushell config"

mkdir -p ~/.config/nushell
link "$DOTFILES/nu/config.nu" ~/.config/nushell/config.nu


echo "-- 6. Installing gdb config"

link "$DOTFILES/tools/.gdbinit" ~/.gdbinit


echo "-- 7. Installing mise and mise-managed tools"

if ! command -v mise &> /dev/null; then
    yes_or_no "?? Install mise" && curl -fsSL https://mise.run | sh
fi

MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"
if [ -x "$MISE" ]; then
    mkdir -p ~/.config/mise
    link "$DOTFILES/mise/config.toml" ~/.config/mise/config.toml
    yes_or_no "?? Install mise-managed tools (mise/config.toml)" && "$MISE" install
else
    echo "!! mise not found, skipping mise-managed tools"
fi


echo "-- 8. Installing remaining OS packages"

SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

function package() {
    if command -v apt-get &> /dev/null; then
        $SUDO apt-get install -q=2 "$1" || echo "-- Package not found. Install manually: $1"
    else
        echo "-- No known package manager found. Install manually: $1"
    fi
}

function pip_package() {
    if command -v pip3 &> /dev/null; then
        pip3 install "$1"
    else
        echo "-- No pip3 found. Install manually: $1"
    fi
}

function install_list() {
    for PACKAGE in "${@:2}"; do
        "$1" "$PACKAGE"
    done
}

if command -v apt-get &> /dev/null; then
    $SUDO apt-get update -q=2
fi

CORE=(
    zsh
    vim
    universal-ctags
    python3
    python3-venv
    python3-pip
)

yes_or_no "?? Install core packages: ${CORE[*]}" && install_list package "${CORE[@]}"

EXTRA=(
    xmllint
    xxd
)

yes_or_no "?? Install extra packages: ${EXTRA[*]}" && install_list package "${EXTRA[@]}"

CPP=(
    clang
    clangd
    gdb
)

yes_or_no "?? Install C++ packages: ${CPP[*]}" && install_list package "${CPP[@]}"

PYTHON=(
    flake8
)

yes_or_no "?? Install python modules: ${PYTHON[*]}" && install_list pip_package "${PYTHON[@]}"


echo "-- 9. Changing login shell"

ZSH_BIN="$(command -v zsh)"
if [ -n "$ZSH_BIN" ]; then
    yes_or_no "?? Change login shell to zsh" && chsh -s "$ZSH_BIN"
else
    echo "!! zsh not found, skipping login shell change"
fi

}


function cmd_update() {

echo "-- 1. Updating mise-managed tools"

MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"
if [ -x "$MISE" ]; then
    "$MISE" upgrade
else
    echo "!! mise not found, run './dotfiles install' first"
fi


echo "-- 2. Updating git submodules"

if ! command -v git &> /dev/null; then
    fail "!! git cannot be found"
fi

git submodule update --init --remote --recursive

}


case "${1:-}" in
    install) cmd_install ;;
    update)  cmd_update ;;
    *)       fail "Usage: $0 {install|update}" ;;
esac
